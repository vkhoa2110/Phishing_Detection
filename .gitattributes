# Preserve snapshot bytes used by manifests; CSV writers intentionally use CRLF.
knowledge/corpus_v1/*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol
reports/**/*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol

# Matplotlib writes trailing spaces in generated SVG path coordinates.
reports/**/*.svg -whitespace
