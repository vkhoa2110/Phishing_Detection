# Giải nén gói model, đặt thư mục con này trong models/.
MODEL_DIR=models/inference_XGBoost_d6_s42

# Dùng nguyên endpoint/model trong ảnh hướng dẫn của bạn.
FPT_ENDPOINT=https://mkp-api.fptcloud.com/v1/chat/completions
FPT_MODEL=DeepSeek-V4-Flash
FPT_API_KEY=

LLM_ALLOWED_HOSTS=mkp-api.fptcloud.com
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=8192
PORT=8000


# RAG: chuẩn bị chỉ mục bằng scripts/rag/prepare_index.py và evaluation.retrieval.
RAG_MODEL_DIR=models/embeddings/multilingual-e5-small
RAG_INDEX_DIR=artifacts/rag/e5-small-v1
RAG_CORPUS=data/knowledge/corpus_v1/documents.jsonl
